# =============================================================================
#  Libra — Library OS · local configuration
#  Copy this file to .env. Every value has a safe default for local development.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Zero-config local default: a SQLite file inside backend/.
DATABASE_URL=sqlite:///./library.db

# PostgreSQL (production / Docker) example:
# DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library_system
# Install psycopg[binary] and have PostgreSQL running before using this URL.

# --- Security ---------------------------------------------------------------
# Generate a long random value in production, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
SECRET_KEY=libra-local-development-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API --------------------------------------------------------------------
API_V1_STR=/api/v1
# Public browser URL used for Stripe Checkout return links.
APP_BASE_URL=http://localhost:8000
PROJECT_NAME=Libra — Library OS
BACKEND_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- Payments (optional) ----------------------------------------------------
# Leave all Stripe values blank to use instant development-mode payments.
# Hosted Checkout uses the secret key; this server does not need a publishable key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=USD

# Membership pricing (USD per month)
PRICE_BASIC=0
PRICE_STUDENT=4.99
PRICE_PREMIUM=9.99
PRICE_FAMILY=14.99

# --- Loan policy ------------------------------------------------------------
DEFAULT_LOAN_DAYS=14
MAX_RENEWALS=2
FINE_PER_DAY=0.25
MAX_ACTIVE_LOANS=10

# --- Email (optional) -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@librarysystem.com
EMAILS_FROM_NAME=Libra — Library OS

# --- Environment ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
